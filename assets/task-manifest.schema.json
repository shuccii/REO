{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Research Dev Orchestrator task manifest v0.3", "type": "object",
  "required": ["schema_version", "run_id", "assurance_profile", "research_contract", "budget", "tasks"],
  "properties": {
    "schema_version": {"const": "0.3.0"}, "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "assurance_profile": {"enum": ["standard", "research_strict"]},
    "research_contract": {"type": ["string", "null"]},
    "budget": {"type": "object", "required": ["max_wall_clock_seconds", "max_retries"], "properties": {
      "max_wall_clock_seconds": {"type": "number", "minimum": 1}, "max_retries": {"type": "integer", "minimum": 0},
      "max_total_tokens": {"type": "integer", "minimum": 1}, "max_llm_calls": {"type": "integer", "minimum": 1}
    }, "additionalProperties": false},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["task_id", "parent_task_id", "goal", "depends_on", "write_scope", "operation_class", "verification_mode", "risk_tags", "required_checks"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}, "parent_task_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "goal": {"type": "string", "minLength": 1}, "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
        "write_scope": {"type": "array", "items": {"type": "object", "required": ["path", "kind"], "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"enum": ["file", "tree"]}}, "additionalProperties": false}},
        "operation_class": {"enum": ["read_only", "reversible_write", "approval_required"]},
        "verification_mode": {"enum": ["formatting", "file_move", "lint", "unit_test_execution", "render_from_reviewed_metrics", "semantic_review_required"]},
        "risk_tags": {"type": "array", "items": {"enum": ["research_conclusion", "external_fact", "statistical_design", "data_leakage", "security_sensitive", "job_claim", "implementation_change"]}},
        "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
