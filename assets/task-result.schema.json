{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Dev Orchestrator task result v0.3",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "parent_task_id", "started_at", "ended_at", "status", "summary", "artifacts", "evidence", "risks", "next_actions", "approval", "verification"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "parent_task_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "worker_id": {"type": "string", "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}|/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*)$"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "needs_revision", "blocked", "awaiting_approval", "failed"]},
    "blocked_reason": {"enum": ["budget_exceeded", "budget_unobservable", "external_dependency", "resource_unavailable"]},
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "research_validation": {"type": "array", "items": {"type": "object", "required": ["gate_id", "status", "reason", "evidence_refs"], "properties": {
      "gate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}, "status": {"enum": ["passed", "failed", "not_run", "not_applicable"]},
      "reason": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": false}},
    "claim_evidence_map": {"type": "array", "items": {"type": "object", "required": ["claim_id", "claim", "status", "evidence_refs"], "properties": {
      "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}, "claim": {"type": "string", "minLength": 1},
      "status": {"enum": ["supported", "limited", "invalidated"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": false}},
    "invalidated_artifacts": {"type": "array", "items": {"type": "string"}},
    "reproduction_bundle": {"type": "string"},
    "review_scope": {"type": "array", "items": {"enum": ["design", "data", "execution", "numerical_results", "interpretation", "claims", "reproducibility"]}},
    "review_findings": {"type": "array", "items": {"type": "object", "required": ["defect_id", "affected_claims", "evidence", "mechanism", "correction", "rerun_scope", "acceptance_condition"], "properties": {
      "defect_id": {"type": "string", "minLength": 1}, "affected_claims": {"type": "array", "items": {"type": "string"}},
      "evidence": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1}, "correction": {"type": "string", "minLength": 1},
      "rerun_scope": {"type": "array", "items": {"type": "string"}}, "acceptance_condition": {"type": "string", "minLength": 1}
    }, "additionalProperties": false}},
    "approval": {"type": "object", "required": ["required", "status", "approved_by", "operation_succeeded"], "properties": {
      "required": {"type": "boolean"}, "status": {"enum": ["not_required", "pending", "approved"]},
      "approved_by": {"enum": [null, "user"]}, "operation_succeeded": {"type": "boolean"}
    }, "additionalProperties": false},
    "verification": {
      "type": "object", "required": ["required_checks", "checks", "validity_review"],
      "properties": {
        "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
        "checks": {"type": "array", "items": {
          "type": "object", "required": ["check_id", "type", "result", "observed_by", "evidence_refs"],
          "properties": {
            "check_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "type": {"enum": ["command", "schema", "hash", "file_exists", "render", "semantic_review"]},
            "result": {"enum": ["passed", "failed", "not_run"]},
            "observed_by": {"enum": ["harness", "worker", "reviewer"]},
            "observer_id": {"type": "string", "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}|/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*)$"},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "command": {"type": "string"}, "exit_code": {"type": "integer"}
          }, "additionalProperties": false
        }},
        "validity_review": {"type": "object", "required": ["required", "status", "reviewer_id"], "properties": {
          "required": {"type": "boolean"}, "status": {"enum": ["passed", "failed", "not_run"]},
          "reviewer_id": {"type": ["string", "null"], "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}|/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*)$"}
        }, "additionalProperties": false}
      }, "additionalProperties": false
    }
  }, "additionalProperties": false
}
